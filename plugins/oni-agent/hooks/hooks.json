{
  "description": "Checks that Agent SDK code was written against the installed type declarations, not from memory. Inert on files that do not import the SDK.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/sdk-drift-guard.mjs"],
            "timeout": 15,
            "statusMessage": "Checking SDK imports"
          }
        ]
      }
    ]
  }
}
